// ================================


// Open a calculator/tool
function openTool(toolId) {

  const tools = document.querySelectorAll(".calculator-tool");

  tools.forEach(function(tool) {
    tool.classList.remove("active");
  });

  const selectedTool = document.getElementById(toolId);

  if (selectedTool) {
    selectedTool.classList.add("active");

    selectedTool.scrollIntoView({
      behavior: "smooth",
      block: "start"
    });
  }
}


// Close all calculators
function closeTools() {

  const tools = document.querySelectorAll(".calculator-tool");

  tools.forEach(function(tool) {
    tool.classList.remove("active");
  });

  window.scrollTo({
    top: 0,
    behavior: "smooth"
  });
}


// Search calculators
function filterTools() {

  const searchInput =
    document.getElementById("search").value.toLowerCase();

  const cards =
    document.querySelectorAll(".tool-card");

  cards.forEach(function(card) {

    const name =
      card.getAttribute("data-name").toLowerCase();

    if (name.includes(searchInput)) {
      card.style.display = "block";
    } else {
      card.style.display = "none";
    }

  });
}


// ================================
// BASIC CALCULATOR
// ================================

function calculateBasic() {

  const input =
    document.getElementById("basicInput").value.trim();

  const result =
    document.getElementById("basicResult");

  if (!input) {
    result.textContent =
      "Please enter a calculation.";
    return;
  }

  // Only allow safe arithmetic characters
  if (!/^[0-9+\-*/().%\s]+$/.test(input)) {

    result.textContent =
      "Please enter a valid mathematical expression.";

    return;
  }

  try {

    const answer =
      Function('"use strict"; return (' + input + ')')();

    if (!Number.isFinite(answer)) {
      result.textContent =
        "The calculation is not valid.";
      return;
    }

    result.textContent =
      "Result: " + answer;

  } catch (error) {

    result.textContent =
      "Invalid calculation.";

  }
}


// ================================
// PERCENTAGE CALCULATOR
// ================================

function calculatePercentage() {

  const value =
    Number(
      document.getElementById("percentageValue").value
    );

  const percentage =
    Number(
      document.getElementById("percentageNumber").value
    );

  const result =
    document.getElementById("percentageResult");

  if (!Number.isFinite(value) ||
      !Number.isFinite(percentage)) {

    result.textContent =
      "Please enter both numbers.";

    return;
  }

  const answer =
    (value * percentage) / 100;

  result.textContent =
    percentage +
    "% of " +
    value +
    " = " +
    answer;

}


// ================================
// LOAN CALCULATOR
// ================================

function calculateLoan() {

  const amount =
    Number(
      document.getElementById("loanAmount").value
    );

  const annualRate =
    Number(
      document.getElementById("loanRate").value
    );

  const months =
    Number(
      document.getElementById("loanMonths").value
    );

  const result =
    document.getElementById("loanResult");

  if (
    !Number.isFinite(amount) ||
    !Number.isFinite(annualRate) ||
    !Number.isFinite(months) ||
    amount <= 0 ||
    months <= 0 ||
    annualRate < 0
  ) {

    result.textContent =
      "Please enter valid loan details.";

    return;
  }

  const monthlyRate =
    annualRate / 100 / 12;

  let monthlyPayment;

  if (monthlyRate === 0) {

    monthlyPayment =
      amount / months;

  } else {

    monthlyPayment =
      amount *
      monthlyRate *
      Math.pow(1 + monthlyRate, months) /
      (Math.pow(1 + monthlyRate, months) - 1);

  }

  const totalPayment =
    monthlyPayment * months;

  const totalInterest =
    totalPayment - amount;

  result.innerHTML =
    "Monthly Payment: " +
    monthlyPayment.toFixed(2) +
    "<br><br>" +

    "Total Repayment: " +
    totalPayment.toFixed(2) +
    "<br><br>" +

    "Total Interest: " +
    totalInterest.toFixed(2);

}


// ================================
// PROFIT & LOSS CALCULATOR
// ================================

function calculateProfit() {

  const cost =
    Number(
      document.getElementById("costPrice").value
    );

  const selling =
    Number(
      document.getElementById("sellingPrice").value
    );

  const result =
    document.getElementById("profitResult");

  if (
    !Number.isFinite(cost) ||
    !Number.isFinite(selling) ||
    cost <= 0
  ) {

    result.textContent =
      "Please enter valid prices.";

    return;
  }

  const difference =
    selling - cost;

  const percentage =
    Math.abs(difference) / cost * 100;

  if (difference > 0) {

    result.innerHTML =
      "Profit: " +
      difference.toFixed(2) +
      "<br><br>" +

      "Profit Percentage: " +
      percentage.toFixed(2) +
      "%";

  } else if (difference < 0) {

    result.innerHTML =
      "Loss: " +
      Math.abs(difference).toFixed(2) +
      "<br><br>" +

      "Loss Percentage: " +
      percentage.toFixed(2) +
      "%";

  } else {

    result.textContent =
      "No profit and no loss.";

  }

}


// ================================
// SIMPLE INTEREST
// ================================

function calculateInterest() {

  const principal =
    Number(
      document.getElementById("principal").value
    );

  const rate =
    Number(
      document.getElementById("interestRate").value
    );

  const time =
    Number(
      document.getElementById("interestTime").value
    );

  const result =
    document.getElementById("interestResult");

  if (
    !Number.isFinite(principal) ||
    !Number.isFinite(rate) ||
    !Number.isFinite(time) ||
    principal < 0 ||
    rate < 0 ||
    time < 0
  ) {

    result.textContent =
      "Please enter valid values.";

    return;
  }

  const interest =
    (principal * rate * time) / 100;

  const finalAmount =
    principal + interest;

  result.innerHTML =
    "Simple Interest: " +
    interest.toFixed(2) +
    "<br><br>" +

    "Final Amount: " +
    finalAmount.toFixed(2);

}


// ================================
// SCIENTIFIC CALCULATOR
// ================================

function calculateScientific() {

  let expression =
    document.getElementById("scientificInput").value
      .trim()
      .toLowerCase();

  const result =
    document.getElementById("scientificResult");

  if (!expression) {

    result.textContent =
      "Please enter a calculation.";

    return;
  }


  // Replace common mathematical functions

  expression =
    expression.replaceAll(
      "sqrt",
      "Math.sqrt"
    );

  expression =
    expression.replaceAll(
      "abs",
      "Math.abs"
    );

  expression =
    expression.replaceAll(
      "log",
      "Math.log10"
    );

  expression =
    expression.replaceAll(
      "pow",
      "Math.pow"
    );


  // Convert trigonometric functions
  // from degrees to radians

  expression =
    expression.replace(
      /Math\.(sin|cos|tan)\(([-\d.]+)\)/g,
      function(match, functionName, number) {

        return (
          "Math." +
          functionName +
          "(" +
          number +
          " * Math.PI / 180)"
        );

      }
    );


  // Allow only safe characters

  if (
    !/^[0-9+\-*/().,\sA-Za-z]+$/.test(expression)
  ) {

    result.textContent =
      "Invalid mathematical expression.";

    return;
  }


  try {

    const answer =
      Function(
        '"use strict"; return (' +
        expression +
        ')'
      )();

    if (!Number.isFinite(answer)) {

      result.textContent =
        "The result is not valid.";

      return;
    }

    result.textContent =
      "Result: " + answer;

  } catch (error) {

    result.textContent =
      "Invalid calculation.";

  }

}


// ================================
// UNIT CONVERTER
// ================================

function convertUnits() {

  const value =
    Number(
      document.getElementById("unitValue").value
    );

  const conversion =
    document.getElementById("unitConversion").value;

  const result =
    document.getElementById("unitResult");

  if (!Number.isFinite(value)) {

    result.textContent =
      "Please enter a value.";

    return;
  }


  let answer;
  let unit;


  switch (conversion) {

    case "m-km":

      answer = value / 1000;
      unit = "km";

      break;


    case "km-m":

      answer = value * 1000;
      unit = "m";

      break;


    case "kg-g":

      answer = value * 1000;
      unit = "g";

      break;


    case "g-kg":

      answer = value / 1000;
      unit = "kg";

      break;


    case "c-f":

      answer = (value * 9 / 5) + 32;
      unit = "°F";

      break;


    case "f-c":

      answer = (value - 32) * 5 / 9;
      unit = "°C";

      break;


    default:

      result.textContent =
        "Please select a conversion.";

      return;

  }


  result.textContent =
    "Result: " +
    answer +
    " " +
    unit;

}


// ================================
// AGE CALCULATOR
// ================================

function calculateAge() {

  const dateInput =
    document.getElementById("dateOfBirth").value;

  const result =
    document.getElementById("ageResult");

  if (!dateInput) {

    result.textContent =
      "Please select your date of birth.";

    return;
  }


  const birthDate =
    new Date(dateInput + "T00:00:00");

  const today =
    new Date();


  if (birthDate > today) {

    result.textContent =
      "Date of birth cannot be in the future.";

    return;
  }


  let years =
    today.getFullYear() -
    birthDate.getFullYear();

  let months =
    today.getMonth() -
    birthDate.getMonth();

  let days =
    today.getDate() -
    birthDate.getDate();


  if (days < 0) {

    months--;

    const previousMonth =
      new Date(
        today.getFullYear(),
        today.getMonth(),
        0
      );

    days += previousMonth.getDate();

  }


  if (months < 0) {

    years--;
    months += 12;

  }


  result.innerHTML =
    "Age: " +
    years +
    " years, " +
    months +
    " months, " +
    days +
    " days.";

}


// ================================
// ENTER KEY SUPPORT
// ================================

document.addEventListener(
  "keydown",
  function(event) {

    if (event.key !== "Enter") {
      return;
    }

    const activeTool =
      document.querySelector(
        ".calculator-tool.active"
      );

    if (!activeTool) {
      return;
    }


    if (activeTool.id === "basicTool") {
      calculateBasic();
    }

    else if (activeTool.id === "percentageTool") {
      calculatePercentage();
    }

    else if (activeTool.id === "loanTool") {
      calculateLoan();
    }

    else if (activeTool.id === "profitTool") {
      calculateProfit();
    }

    else if (activeTool.id === "interestTool") {
      calculateInterest();
    }

    else if (activeTool.id === "scientificTool") {
      calculateScientific();
    }

    else if (activeTool.id === "unitTool") {
      convertUnits();
    }

    else if (activeTool.id === "ageTool") {
      calculateAge();
    }

  }
);
