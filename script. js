function calculatePercentage() {
  const number = Number(document.getElementById("percentNumber").value);
  const percent = Number(document.getElementById("percentValue").value);

  if (isNaN(number) || isNaN(percent)) {
    document.getElementById("percentResult").textContent = "Please enter both numbers.";
    return;
  }

  const result = (number * percent) / 100;

  document.getElementById("percentResult").textContent =
    `${percent}% of ${number} = ${result}`;
}


function calculateAge() {
  const birth = document.getElementById("birthDate").value;

  if (!birth) {
    document.getElementById("ageResult").textContent =
      "Please enter your birth date.";
    return;
  }

  const birthDate = new Date(birth);
  const today = new Date();

  let years = today.getFullYear() - birthDate.getFullYear();
  let months = today.getMonth() - birthDate.getMonth();
  let days = today.getDate() - birthDate.getDate();

  if (days < 0) {
    months--;
  }

  if (months < 0) {
    years--;
    months += 12;
  }

  document.getElementById("ageResult").textContent =
    `You are ${years} years and ${months} months old.`;
}


function calculateDiscount() {
  const price = Number(document.getElementById("price").value);
  const discount = Number(document.getElementById("discount").value);

  if (isNaN(price) || isNaN(discount)) {
    document.getElementById("discountResult").textContent =
      "Please enter the price and discount.";
    return;
  }

  const saved = (price * discount) / 100;
  const finalPrice = price - saved;

  document.getElementById("discountResult").textContent =
    `You save ${saved.toFixed(2)}. Final price: ${finalPrice.toFixed(2)}`;
}


function calculateInterest() {
  const principal = Number(document.getElementById("principal").value);
  const rate = Number(document.getElementById("interestRate").value);
  const years = Number(document.getElementById("interestYears").value);

  if (isNaN(principal) || isNaN(rate) || isNaN(years)) {
    document.getElementById("interestResult").textContent =
      "Please enter all values.";
    return;
  }

  const interest = (principal * rate * years) / 100;
  const total = principal + interest;

  document.getElementById("interestResult").textContent =
    `Interest: ${interest.toFixed(2)} | Total: ${total.toFixed(2)}`;
}


function calculateAverage() {
  const input = document.getElementById("averageNumbers").value;

  const numbers = input
    .split(",")
    .map(Number)
    .filter(n => !isNaN(n));

  if (numbers.length === 0) {
    document.getElementById("averageResult").textContent =
      "Enter numbers separated by commas.";
    return;
  }

  const total = numbers.reduce((sum, n) => sum + n, 0);
  const average = total / numbers.length;

  document.getElementById("averageResult").textContent =
    `Average = ${average}`;
}


function convertTemperature() {
  const temperature = Number(
    document.getElementById("temperature").value
  );

  const type = document.getElementById("temperatureType").value;

  if (isNaN(temperature)) {
    document.getElementById("temperatureResult").textContent =
      "Please enter a temperature.";
    return;
  }

  let result;

  if (type === "CtoF") {
    result = (temperature * 9) / 5 + 32;
    document.getElementById("temperatureResult").textContent =
      `${temperature}°C = ${result.toFixed(2)}°F`;
  } else {
    result = ((temperature - 32) * 5) / 9;
    document.getElementById("temperatureResult").textContent =
      `${temperature}°F = ${result.toFixed(2)}°C`;
  }
}


function countWords() {
  const text = document.getElementById("textInput").value.trim();

  if (!text) {
    document.getElementById("wordResult").textContent =
      "Words: 0 | Characters: 0";
    return;
  }

  const words = text.split(/\s+/).length;
  const characters = text.length;

  document.getElementById("wordResult").textContent =
    `Words: ${words} | Characters: ${characters}`;
}


function randomNumber() {
  const minimum = Number(document.getElementById("minimum").value);
  const maximum = Number(document.getElementById("maximum").value);

  if (
    isNaN(minimum) ||
    isNaN(maximum) ||
    minimum > maximum
  ) {
    document.getElementById("randomResult").textContent =
      "Enter a valid minimum and maximum.";
    return;
  }

  const result =
    Math.floor(Math.random() * (maximum - minimum + 1)) + minimum;

  document.getElementById("randomResult").textContent =
    `Random number: ${result}`;
}
